{
  "expo": {
    "name": "Smart Kitchen",
    "slug": "smart-kitchen",
    "scheme": "smartkitchen",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "KitchenSmart uses the camera to scan a barcode when you add food."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.smartkitchen.dev"
    },
    "android": {
      "package": "app.smartkitchen.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
