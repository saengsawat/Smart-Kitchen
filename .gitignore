# Dependencies & builds (for when code arrives at M0-T1)
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Environment & secrets — never commit; .env.example carries names only
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# OneDrive / Office lock & temp files
~$*
*.tmp

# Logs
*.log
logs/

# Claude Code agent worktrees (harness-created, never committed; also keeps them out of prettier --check)
.claude/worktrees/

# Expo (apps/mobile, M3-T1): local dev cache and the typed-routes file Expo
# regenerates on every `expo start`/`expo export`
.expo/
expo-env.d.ts
