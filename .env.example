# Names only — no values, no secrets. See CLAUDE.md rule 12.
# Populated as each ticket introduces the config it needs; empty at M0-T1
# because no adapters, database, or auth integration exist yet.

# --- apps/api ---
PORT=
NODE_ENV=
# Postgres connection string (M1-T2). Unset ⇒ the database test suites skip
# with a loud notice; CI always sets it against a throwaway service container.
DATABASE_URL=
# Identity adapter to register (M2-T1, D-022). The only value that exists today
# is `fixture`, which loads the synthetic sign-ins in tests/fixtures/identity/.
# The API refuses to start with `fixture` and NODE_ENV=production, and refuses
# to start at all when this is unset, because there is no anonymous mode.
SK_IDENTITY=
# Log level (M2-T1). Defaults to `info`, or `silent` under vitest.
SK_LOG_LEVEL=
# Pepper for hashing household join codes (M2-T3), at least 32 characters. A
# secret outside development: set it from the platform's secret store. Unset
# with NODE_ENV unset/development/test falls back to a public development value;
# anywhere else the API refuses to start. The seed must see the same value.
SK_JOIN_CODE_PEPPER=
# Open Food Facts base URL for live barcode lookups (M2-T4a, D-025). Unset means
# production (https://world.openfoodfacts.org). OFF's staging host
# (https://world.openfoodfacts.net) is for manual developer testing; the API
# sends OFF's published staging basic auth to that host only. https only, or
# plain http on localhost for a local stub. The test suite never calls OFF.
SK_OFF_BASE_URL=
# User-Agent sent to Open Food Facts (M2-T4a). OFF asks for
# "AppName/Version (ContactEmail)". Unset uses a default that names the app and
# the project URL and carries no personal data; set a contact address here only
# in a deployment that should be reachable by OFF.
SK_OFF_USER_AGENT=
# Set to 1 to run the one live OFF smoke test (staging by default). Never set
# in CI; the default suite is network-free (rule 18).
SK_OFF_LIVE_TEST=
